# === server/.env (copiar a .env y llenar; NUNCA subir .env) ===
PORT=4000
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=utmdesk

# Sesión
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES_IN=8h
SEED_DEFAULT_PASSWORD=cambia-esto-solo-para-demo

# Contador diario y anual: colección `contadores` en MongoDB (sin Redis; decisión del docente).

# Evidencias (Supabase Storage, bucket privado)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=evidencias
SIGNED_URL_TTL_SECONDS=3600

# === web/.env ===
VITE_API_URL=http://localhost:4000/api
